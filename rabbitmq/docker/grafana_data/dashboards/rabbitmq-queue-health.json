      "title": "Message bytes in queues",
      "type": "timeseries"
    },
    {
      "datasource": {"type": "prometheus", "uid": "${datasource}"},
      "description": "Consumer utilisation < 1.0 means a queue has spare capacity that consumers aren't taking — either prefetch is too low or the consumer can't keep up. A drop here often precedes a backlog spike.",
      "fieldConfig": {
        "defaults": {
          "color": {"mode": "thresholds"},
          "custom": {"drawStyle": "line", "fillOpacity": 10, "lineWidth": 2, "showPoints": "never"},
          "max": 1,
          "min": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {"color": "red", "value": null},
              {"color": "yellow", "value": 0.5},
              {"color": "green", "value": 0.85}
            ]
          },
          "unit": "percentunit"
        }
      },
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 33},
      "id": 23,
      "options": {
        "legend": {"calcs": ["mean"], "displayMode": "list", "placement": "bottom"},
        "tooltip": {"mode": "multi"}
      },
      "targets": [
        {
          "datasource": {"type": "prometheus", "uid": "${datasource}"},
          "expr": "avg(rabbitmq_queue_consumer_utilisation)",
          "legendFormat": "avg utilisation",
          "refId": "A"
        },
        {
          "datasource": {"type": "prometheus", "uid": "${datasource}"},
          "expr": "min(rabbitmq_queue_consumer_utilisation)",
          "legendFormat": "min utilisation",
          "refId": "B"
        }
      ],
      "title": "Consumer utilisation",
      "type": "timeseries"
    },
    {
